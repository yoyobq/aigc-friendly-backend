{
  "name": "aigc-friendly-architecture-backend",
  "version": "1.6.1",
  "description": "A NestJS backend architecture optimized for AIGC/Copilot scenarios.",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npm run build:api",
    "prebuild:api": "node scripts/clean-dist.js && npm run capability:docs:check",
    "build:api": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run start:api",
    "start:api": "NODE_ENV=production node dist/src/bootstraps/api/main.js",
    "start:dev": "npm run dev",
    "dev": "concurrently --kill-others-on-fail --names api,worker --prefix-colors blue,magenta \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:api": "TZ=Asia/Shanghai NODE_ENV=development nest start --entryFile bootstraps/api/main --watch",
    "start:debug": "TZ=Asia/Shanghai NODE_ENV=development nest start --entryFile bootstraps/api/main --debug --watch",
    "start:prod": "npm run start:api",
    "lint:usecase-normalize-guard": "node scripts/check-usecase-normalize-guard.js",
    "lint:architecture-fixtures": "node scripts/check-eslint-architecture-fixtures.mjs",
    "lint": "npm run capability:docs:check && npm run lint:usecase-normalize-guard && npm run lint:architecture-fixtures && eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --no-cache",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test:unit": "TZ=Asia/Shanghai node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "TZ=Asia/Shanghai node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "TZ=Asia/Shanghai node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "TZ=Asia/Shanghai node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register ./node_modules/jest/bin/jest.js --runInBand",
    "test": "clear && TZ=Asia/Shanghai NODE_ENV=e2e node ./test/run-e2e-group.js core",
    "test:e2e": "clear && TZ=Asia/Shanghai NODE_ENV=e2e node ./test/run-e2e-group.js core",
    "test:e2e:core": "clear && TZ=Asia/Shanghai NODE_ENV=e2e node ./test/run-e2e-group.js core",
    "test:e2e:worker": "clear && TZ=Asia/Shanghai NODE_ENV=e2e node ./test/run-e2e-group.js worker",
    "test:e2e:smoke": "clear && TZ=Asia/Shanghai NODE_ENV=e2e node ./test/run-e2e-group.js smoke",
    "test:e2e:all": "npm run test:e2e:core && npm run test:e2e:worker",
    "test:e2e:file": "clear && TZ=Asia/Shanghai NODE_ENV=e2e node ./test/run-e2e-group.js --file",
    "test:e2e:watch": "TZ=Asia/Shanghai NODE_ENV=e2e node ./test/run-e2e-group.js --file --watch",
    "test:e2e:debug": "TZ=Asia/Shanghai NODE_ENV=e2e node ./test/run-e2e-group.js --file --inspect-brk",
    "migration:drill:empty-db": "TZ=Asia/Shanghai NODE_ENV=e2e ts-node -r tsconfig-paths/register src/infrastructure/database/verify-empty-db-migrations.ts",
    "ci:baseline-drill": "npm run migration:drill:empty-db",
    "dev:worker": "TZ=Asia/Shanghai NODE_ENV=development nest start --entryFile bootstraps/worker/main --watch",
    "start:worker": "NODE_ENV=production node dist/src/bootstraps/worker/main.js",
    "capability:list": "TZ=Asia/Shanghai ts-node -r tsconfig-paths/register scripts/capability-list.ts list",
    "capability:docs": "TZ=Asia/Shanghai ts-node -r tsconfig-paths/register scripts/capability-list.ts docs",
    "capability:docs:check": "TZ=Asia/Shanghai ts-node -r tsconfig-paths/register scripts/capability-list.ts check",
    "start:all": "concurrently --kill-others-on-fail --names api,worker --prefix-colors blue,magenta \"npm run start:api\" \"npm run start:worker\"",
    "smoke:dev": "node scripts/smoke-dev-runtimes.js",
    "test:unit:open-handles": "TZ=Asia/Shanghai node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "axios": "^1.20.0",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "graphql-type-json": "^0.3.2",
    "graphql-ws": "^6.2.1",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.3",
    "nestjs-pino": "^5.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "ws": "^8.21.3",
    "concurrently": "^10.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "eslint-import-resolver-typescript": "^4.4.5"
  },
  "overrides": {
    "test-exclude": {
      "glob": "11.1.0"
    }
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^24.20.0",
    "npm": ">=11.19 <12"
  },
  "allowScripts": {
    "@apollo/protobufjs@1.2.8": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.1": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true
  }
}
